[Unit]
Description=AirTrail flight diary
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/opt/airtrail/.env

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/airtrail
ExecStartPre=/usr/bin/docker compose --env-file /opt/airtrail/.env -f /opt/airtrail/compose.yml config --quiet
ExecStart=/usr/bin/docker compose --env-file /opt/airtrail/.env -f /opt/airtrail/compose.yml up -d --remove-orphans --wait --wait-timeout 180
ExecReload=/usr/bin/docker compose --env-file /opt/airtrail/.env -f /opt/airtrail/compose.yml up -d --remove-orphans --wait --wait-timeout 180
ExecStop=/usr/bin/docker compose --env-file /opt/airtrail/.env -f /opt/airtrail/compose.yml down
TimeoutStartSec=0
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
