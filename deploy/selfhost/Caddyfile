{
	admin off
	http_port 8080
}

airtrail.example.com {
	encode zstd gzip
	reverse_proxy airtrail:3000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	log {
		output stdout
		format console
	}
}
