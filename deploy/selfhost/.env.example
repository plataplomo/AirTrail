# Public URL. It must exactly match the URL used in the browser.
ORIGIN=https://airtrail.example.com

# Keep the password alphanumeric and replace both placeholders with the same value.
DB_URL=postgres://airtrail:replace_with_the_same_random_password@db:5432/airtrail
DB_PASSWORD=replace_with_the_same_random_password
DB_DATABASE_NAME=airtrail
DB_USERNAME=airtrail

# Persistent uploads are mounted at this path by compose.yml.
UPLOAD_LOCATION=/app/uploads
BODY_SIZE_LIMIT=20M
